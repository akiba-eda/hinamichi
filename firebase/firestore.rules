rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAcceptedFriendOf(uid) {
      return signedIn() && exists(/databases/$(database)/documents/friends/$(uid)/list/$(request.auth.uid))
        && get(/databases/$(database)/documents/friends/$(uid)/list/$(request.auth.uid)).data.status == 'accepted';
    }
    // 位置は「承認済み」だけでは足りず、その相手に対して shareLocation を
    // 明示的に立てているときだけ読める。既定は共有しない。
    function isLocationSharedWith(uid) {
      return isAcceptedFriendOf(uid)
        // 追加した時点のドキュメントにはこの項目が無い。存在しない項目を
        // 直接読むとルールが評価エラーになるので、既定 false で取り出す。
        && get(/databases/$(database)/documents/friends/$(uid)/list/$(request.auth.uid)).data.get('shareLocation', false) == true;
    }

    // Own profile: read; client may only touch consent/displayName (everything else via server)
    match /users/{uid} {
      allow read: if isMe(uid);
      allow update: if isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consent', 'displayName', 'updatedAt']);
      allow create, delete: if false;
    }
    // Friend list: read own; toggle autoShare / shareLocation only (server writes the rest)
    match /friends/{uid}/list/{friendUid} {
      allow read: if isMe(uid);
      allow update: if isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['autoShare', 'shareLocation']);
      allow create, delete: if false;
    }
    // Public status: owner + accepted friends can read. Server-only writes.
    match /statuses/{uid} {
      allow read: if isMe(uid) || isAcceptedFriendOf(uid);
      allow write: if false;
    }
    // Last known location. Readable only by friends the owner explicitly
    // allowed. Written by the server only, so a client cannot fake someone
    // else's position.
    match /locations/{uid} {
      allow read: if isMe(uid) || isLocationSharedWith(uid);
      allow write: if false;
    }
    // やりとり。スレッド名は uid を並べ替えて繋いだものなので、割れば
    // 当事者が分かる。対応表を別に持たずに、当事者2人だけに閉じられる。
    match /messages/{threadId}/list/{messageId} {
      allow read: if signedIn() && threadId.split('_').hasAny([request.auth.uid]);
      allow write: if false; // 送信はサーバー経由(友だち確認と通知のため)
    }
    // よく行く場所。本人だけ。出入りの判定はサーバーがする。
    match /places/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
      match /list/{placeId} {
        allow read: if isMe(uid);
        allow write: if false;
      }
    }
    // 到着・出発。安否を共有している相手まで見える。
    match /placeEvents/{uid}/list/{eventId} {
      allow read: if isMe(uid) || isAcceptedFriendOf(uid);
      allow write: if false;
    }
    // 合流。メンバーだけ。
    match /meetups/{meetupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }
    // 緊急時情報(本名・住所・年齢・電話)。
    // 本人と、本人が出した SOS の宛先だけが読める。SOS を閉じると
    // revealedTo が空になり、また読めなくなる。書き込みはサーバーのみ。
    match /emergency/{uid} {
      allow read: if isMe(uid) || (signedIn() && request.auth.uid in resource.data.get('revealedTo', []));
      allow write: if false;
    }
    // 代理通報の依頼。本人と宛先だけ。
    match /sos/{sosId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || request.auth.uid in resource.data.recipients);
      allow write: if false;
    }
    // Incidents & agent log: owner read-only
    match /incidents/{incidentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
      match /agentLog/{seq} {
        allow read: if signedIn() && get(/databases/$(database)/documents/incidents/$(incidentId)).data.uid == request.auth.uid;
        allow write: if false;
      }
    }
    // Alerts & crowd: public read, server-only write
    match /alerts/{id} { allow read: if signedIn(); allow write: if false; }
    match /shelterCrowd/{id} { allow read: if signedIn(); allow write: if false; }
    match /shelterCache/{id} { allow read: if signedIn(); allow write: if false; }
    match /alertsSeen/{id} { allow read, write: if false; }
    match /approvals/{id} { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }
  }
}
