# OrcaRouter
ORCA_API_KEY=sk-orca-xxxxx
ORCA_BASE_URL=https://api.orcarouter.ai/v1
ORCA_ROUTER_TRIAGE=orcarouter/hina-triage
ORCA_ROUTER_DECIDE=orcarouter/hina-decide
# "true" にすると OrcaRouter Prompts(prompt_ref)を使う。未登録なら false(ローカルのプロンプトを送る)
ORCA_USE_PROMPT_REF=false
# フォールバックチェーン(カンマ区切り)。/v1/models で実在確認して差し替える
ORCA_FALLBACK_TRIAGE=openai/gpt-4o-mini,google/gemini-2.5-flash-lite
ORCA_FALLBACK_DECIDE=openai/gpt-4o,google/gemini-2.5-pro

# Firebase(サービスアカウント JSON を base64 したもの)
FIREBASE_SERVICE_ACCOUNT_B64=
# OpenRouteService
ORS_API_KEY=
# cron-job.org からの呼び出しを守る共有シークレット
CRON_TOKEN=change-me
# デモ発火を許可する uid(カンマ区切り)。空なら誰でも(開発時)
DEMO_ADMIN_UIDS=
